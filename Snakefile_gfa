                prefix=prefix,
                analysis=analysis,
            ).output[0]

            with open(count_file) as handle:
                n_factors = int(handle.read().strip())

            # TEMP
#            n_factors = 3

            outputs.extend(
                expand(
                    annot_dir
                    + "factors/{prefix}_{analysis}_{snp_set}_factor_{factor}_trait_support.tsv",
                    prefix=prefix,
                    analysis=analysis,
                    snp_set=snp_sets,
                    factor=range(1, n_factors + 1),
                )
            )

    return outputs

